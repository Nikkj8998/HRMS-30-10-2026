<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- PHP files in this directory are executed by the PHP FastCGI handler.
             All URL routing is handled by the parent web.config at the site root.
             Do NOT add SPA fallback rules here - they intercept PHP execution. -->
        <handlers>
            <add name="PHP-FastCGI" path="*.php" verb="GET,HEAD,POST,PUT,DELETE,OPTIONS"
                 modules="FastCgiModule" scriptProcessor="C:\php\php-cgi.exe"
                 resourceType="File" requireAccess="Script" />
        </handlers>
    </system.webServer>
</configuration>
